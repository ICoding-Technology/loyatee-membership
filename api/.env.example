FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-me
PORT=5000

ARANGO_URL=http://localhost:8529
ARANGO_DB=loyatee
ARANGO_USER=root
ARANGO_PASSWORD=rootpass

REDIS_URL=redis://localhost:6379/0
OTP_TTL_SECONDS=300

# Google OAuth — get a Web Client ID from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=

# Telegram bot — create via @BotFather, then /setdomain to your dev URL
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_NAME=
TELEGRAM_AUTH_MAX_AGE=86400

# Telegram Gateway — phone-OTP delivery. Get token at https://gateway.telegram.org
# SENDER_USERNAME is optional, used if you've set up a verified sender.
TELEGRAM_GATEWAY_TOKEN=AAGjQAAApV8DcrYPMHDTOTHxCMEqKg9Xxq95nUVWsUgxwQ
TELEGRAM_GATEWAY_SENDER_USERNAME=
